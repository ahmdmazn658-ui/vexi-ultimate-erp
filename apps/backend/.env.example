APP_NAME="ERP System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# فعّلها لما الاستضافة بتنهي SSL عند بروكسي (Render، الاستضافات المشتركة).
# من غيرها الروابط المولّدة — زي رابط تحميل المستند — بتطلع http والمتصفح
# بيرفضها كـ mixed content على صفحة https.
FORCE_HTTPS=false

LOG_CHANNEL=stack
LOG_LEVEL=info

# قاعدة البيانات — الإعداد الافتراضي هنا لـ Supabase (PostgreSQL، مجاني دائم).
# روح لـ Project Settings → Database في Supabase وانسخ بيانات "Connection parameters".
# لو بتشغل محليًا بالـ docker-compose الموجود، سيبها زي ما هي أو استخدم mysql.
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.xxxxxxxxxxxx
DB_PASSWORD=

# سيبها فاضية على MySQL 8 أو PostgreSQL.
# على MySQL 5.6 (الاستضافات المشتركة) حطها 191 — حد المفتاح في InnoDB هناك
# 767 بايت، وعمود utf8mb4 بطول 255 بياخد 1020 بايت فالمايجريشن بتفشل.
DB_STRING_LENGTH=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

# الواجهة الأمامية — دومينات مسموح لها تنادي الـ API (مفصولة بفاصلة).
# في التطوير Vite بيعمل proxy فمش محتاجة، لكن في الإنتاج لازم تحدد دومين الواجهة.
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# e-invoicing / ZATCA
COMPANY_NAME="Vexi Ultimate Co."
COMPANY_VAT_NUMBER=300000000000003
COMPANY_CR_NUMBER=
COMPANY_ADDRESS=
COMPANY_CITY=Riyadh
