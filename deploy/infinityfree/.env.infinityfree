# ═══════════════════════════════════════════════════════════════
#  erp-app/.env — نسخة الاستضافة المشتركة (InfinityFree)
# ═══════════════════════════════════════════════════════════════
#  انسخ الملف ده باسم `.env` جوه مجلد erp-app، واملا القيم الفاضية.

APP_NAME="ERP System"
APP_ENV=production
APP_DEBUG=false

# ولّد المفتاح محليًا بـ: php artisan key:generate --show
# أو من المتصفح بعد الرفع: /setup.php?token=...&action=key
APP_KEY=

# الدومين بتاعك بالظبط، من غير سلاش في الآخر
APP_URL=https://yourdomain.infinityfreeapp.com

# روابط زي رابط تحميل المستند لازم تطلع https، والاستضافة بتنهي SSL عند البروكسي
FORCE_HTTPS=true

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── قاعدة البيانات ────────────────────────────────────────────
# من لوحة تحكم InfinityFree → MySQL Databases. القيم بتبدأ بـ sql### و if0_
DB_CONNECTION=mysql
DB_HOST=sql###.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_00000000_erp
DB_USERNAME=if0_00000000
DB_PASSWORD=

# ⚠️ لازم على MySQL 5.6 (وده اللي شغال على الاستضافة المجانية).
# InnoDB في 5.6 بحد أقصى 767 بايت للمفتاح، وعمود utf8mb4 بطول 255 بياخد
# 1020 بايت — يعني `unique` على users.email هيفشل بـ "key was too long".
# 191 × 4 = 764 بايت، فبتعدّي.
DB_STRING_LENGTH=191

# ── الجلسات والكاش والطوابير ──────────────────────────────────
# `database` بيشتغل، بس بياكل من حد الـ 50 ميجا بتاع القاعدة.
# `file` أخف وأسرع على الاستضافة المشتركة.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file

# مفيش cron على الخطة المجانية، فالطوابير لازم تكون sync (تتنفذ فورًا)
QUEUE_CONNECTION=sync

# ── الواجهة ───────────────────────────────────────────────────
# الواجهة والـ API على نفس الدومين هنا، فالـ CORS مش مستخدم أصلاً.
# سيبها على نفس الدومين للأمان.
CORS_ALLOWED_ORIGINS=https://yourdomain.infinityfreeapp.com
SANCTUM_STATEFUL_DOMAINS=yourdomain.infinityfreeapp.com

# ── التنصيب ───────────────────────────────────────────────────
# نص عشوائي طويل. بيحمي setup.php.
# امسح السطر ده (وامسح setup.php) بعد ما تخلص التنصيب.
INSTALL_TOKEN=

# ── بيانات المنشأة (الفوترة الإلكترونية) ──────────────────────
COMPANY_NAME="اسم شركتك"
COMPANY_VAT_NUMBER=300000000000003
COMPANY_CR_NUMBER=
COMPANY_ADDRESS=
COMPANY_CITY=Riyadh

# ── البريد ────────────────────────────────────────────────────
# الاستضافة المجانية بتحجب الاتصالات الخارجية، يعني SMTP مش هيشتغل.
# سيبها log لحد ما تنقل لاستضافة تسمح بالاتصال الخارجي.
MAIL_MAILER=log
