# ═══════════════════════════════════════════════════════════════
#  htdocs/erp-app/.htaccess — حماية ملفات التطبيق
# ═══════════════════════════════════════════════════════════════
#  على الاستضافة المشتركة كل حاجة لازم تبقى جوه htdocs، يعني ملفات
#  Laravel نفسها بتبقى تحت مجلد الويب. الملف ده بيمنع الوصول المباشر
#  ليها من المتصفح — من غيره أي حد يقدر يفتح:
#      https://yourdomain/erp-app/.env
#  ويشوف بيانات قاعدة البيانات ومفتاح التطبيق.
#
#  PHP لسه بيقدر يقرا الملفات دي عادي — المنع على مستوى أباتشي بس.

# أباتشي 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# أباتشي 2.2 (بعض الاستضافات المشتركة لسه عليها)
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

Options -Indexes
